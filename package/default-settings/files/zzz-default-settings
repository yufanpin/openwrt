#!/bin/sh

# 自动检测 OpenWrt 版本号
if [ -f /etc/openwrt_release ]; then
  . /etc/openwrt_release
  RELEASE="${DISTRIB_RELEASE:-snapshot}"
else
  RELEASE="snapshot"
fi

# 自动检测设备架构
ARCH=$(opkg print-architecture | awk 'NR==2 {print $2}')

echo "检测到 OpenWrt 版本：$RELEASE"
echo "检测到设备架构：$ARCH"

# 处理版本号：简化为 snapshot 或保持原样
if echo "$RELEASE" | grep -qi snapshot; then
  RELEASE="snapshot"
fi

# 生成 /etc/opkg/distfeeds.conf，去除 core 源
cat > /etc/opkg/distfeeds.conf <<EOF
src/gz openwrt_base https://mirrors.pku.edu.cn/openwrt/releases/${RELEASE}/packages/${ARCH}/base
src/gz openwrt_luci https://mirrors.pku.edu.cn/openwrt/releases/${RELEASE}/packages/${ARCH}/luci
src/gz openwrt_packages https://mirrors.pku.edu.cn/openwrt/releases/${RELEASE}/packages/${ARCH}/packages
src/gz openwrt_routing https://mirrors.pku.edu.cn/openwrt/releases/${RELEASE}/packages/${ARCH}/routing
src/gz openwrt_telephony https://mirrors.pku.edu.cn/openwrt/releases/${RELEASE}/packages/${ARCH}/telephony
EOF

echo "✅ /etc/opkg/distfeeds.conf 已生成并指向 PKU 镜像"






# 设置 LuCI 默认语言为中文、默认主题为 bootstrap
uci set luci.main.lang=zh_cn
uci set luci.main.mediaurlbase=/luci-static/bootstrap
uci commit luci

# 设置时区为中国上海
uci set system.@system[0].timezone=CST-8
uci set system.@system[0].zonename=Asia/Shanghai
uci commit system

# 允许自动挂载未定义设备
uci set fstab.@global[0].anon_mount=1
uci commit fstab

# 创建 ip 命令软链接（部分脚本依赖）
ln -sf /sbin/ip /usr/bin/ip

# IPv6 DHCP 和路由通告配置
uci set dhcp.lan.ra='server'
uci -q del dhcp.lan.dhcpv6
uci set dhcp.lan.dns_service='0'
uci set dhcp.lan.ra_management='1'
uci -q del dhcp.lan.ra_slaac
uci commit dhcp

# 启用所有无线接口
sed -i '/option disabled/d' /etc/config/wireless
sed -i '/set wireless.radio${devidx}.disabled/d' /lib/wifi/mac80211.sh
wifi up

# 修改系统版本显示信息
sed -i '/DISTRIB_DESCRIPTION/d' /etc/openwrt_release
echo "DISTRIB_DESCRIPTION='OpenWrt ${RELEASE} with PKU Mirror'" >> /etc/openwrt_release

# 删除状态页（可用于精简 UI）
rm -rf /usr/lib/lua/luci/view/admin_status/index

# 替换页脚 GitHub 链接为 lienol
sed -i 's#openwrt/luci#lienol/openwrt-luci#g' /usr/lib/lua/luci/view/themes/*/footer.htm

# 禁用不常用服务，避免资源占用
for svc in \
  php7-fastcgi php7-fpm php8-fastcgi php8-fpm \
  softethervpnbridge softethervpnserver softethervpnclient \
  haproxy kcptun; do
  /etc/init.d/$svc disable 2>/dev/null
done

# 修复 init 脚本权限
chmod 0755 /etc/init.d/*

# 清理 LuCI 缓存
rm -rf /tmp/luci-*cache

echo "✅ 初始化脚本执行完成，建议运行：opkg update"

exit 0
